# Copier en supabase/functions/.env (ignoré par git) pour le développement local.
# En production : npx supabase secrets set ANTHROPIC_API_KEY=... (jamais dans un fichier du dépôt)
ANTHROPIC_API_KEY=

# Origines autorisées (CORS), séparées par des virgules ; * en développement.
OKA_ORIGINES=*

# Questions libres par tablette et par jour.
IA_QUOTA_JOUR=150

# Option (décision D9) : modèle local compatible OpenAI au lieu de Claude Haiku 5.5.
# IA_FOURNISSEUR=local
# IA_URL=http://host.docker.internal:11434
# IA_MODELE=qwen2.5:7b
